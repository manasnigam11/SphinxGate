# ── SphinxGate — root .gitignore ─────────────────────────────────────────────
# Covers both backend/ and frontend/ sub-projects from the repo root.
# Each sub-project also has its own .gitignore for more specific rules.

# ── OS / editor junk ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ── Secrets / credentials ─────────────────────────────────────────────────────
# NEVER commit API keys or secrets.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ── Python (backend) ─────────────────────────────────────────────────────────
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/*.egg-info/
backend/**/*.egg-info/
backend/dist/
backend/build/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/coverage.xml

# ── Backend Runtime Data (Telemetry/Incidents) ──────────────────────────────
backend/data/*.json
backend/data/*.jsonl
!backend/data/.gitkeep
backend/incidents_dump.json

# ── Node / frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/.vite/
frontend/vite.config.*.timestamp-*
frontend/*.tsbuildinfo
frontend/*.log
frontend/logs/

# ── Figma / tooling artifacts ─────────────────────────────────────────────────
frontend/.figma/design-context/
frontend/.plugins/
frontend/.opencode-skills/
frontend/.claude-replay.*
frontend/.tmp-*

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
